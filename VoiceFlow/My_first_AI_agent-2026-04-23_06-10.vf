  "promptMessages": [
    {
      "id": "69e919da8d54d5264d0f9b1f",
      "promptID": "69e919da8d54d5264d0f9b1e",
      "pairID": null,
      "type": "role",
      "data": {
        "role": "system",
        "content": [
          {
            "text": [
              "#MESSAGE DE CLÔTURE\n\nAdapter le message au profil :\n\nPROFIL 25-34 ans :\n\"Parfait 🚀 Ton plan est en place, tes objectifs sont clairs. Plus qu'à laisser l'épargne faire son travail ! À bientôt ",
              {
                "variableID": "69e8a04c9b8afffb2de9267d"
              },
              " 👋\"\n\nPROFIL JUNIOR :\n\"Super 🎉 T'as fait le premier pas, c'est souvent le plus dur ! On est là si t'as besoin. À bientôt ",
              {
                "variableID": "69e8a04c9b8afffb2de9267d"
              },
              " 👋\"\n\nPROFIL 35-50 ans :\n\"Très bien 👍 Ton plan est solide. On se retrouve sur ton tableau de bord pour suivre ta progression. À bientôt ",
              {
                "variableID": "69e8a04c9b8afffb2de9267d"
              },
              " !\"\n\nPROFIL SENIOR :\n\"Parfait 😊 Votre plan est bien en place. Nous restons disponibles si vous avez la moindre question. À bientôt ",
              {
                "variableID": "69e8a04c9b8afffb2de9267d"
              },
              " !\"\n\n→ Fin de la conversation."
            ]
          }
        ]
      },
      "createdAt": "2026-04-22T18:56:26.000Z"
    },
    {
      "id": "69e91a798d54d5264d0f9b21",
