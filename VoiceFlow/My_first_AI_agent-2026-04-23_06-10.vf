      "buttonTool": {
        "enabled": true,
        "messages": null,
        "description": "<25 000€"
      },
      "cardTool": null,
      "carouselTool": null,
      "callForwardTool": null,
      "endTool": null,
      "skipTurnTool": null,
      "isOperator": false,
